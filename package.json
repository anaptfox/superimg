{
  "name": "superimg-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "SuperImg monorepo",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r --filter '!docs' build",
    "build:render": "pnpm --filter @superimg/cli... run build",
    "rebuild:render": "pnpm --filter @superimg/cli... run clean && pnpm --filter @superimg/cli... run build",
    "rebuild": "pnpm -r clean && pnpm -r --filter '!docs' build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test -- --coverage",
    "clean": "pnpm -r clean",
    "lint": "eslint packages --max-warnings 0",
    "videos": "node ./packages/superimg/dist/cli.js dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3"
    }
  },
  "devDependencies": {
    "@seydx/node-av-darwin-arm64": "^6.1.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@shikijs/langs": "^4.3.0",
    "@shikijs/themes": "^4.3.0",
    "playwright": "^1.61.1"
  }
}
