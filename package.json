{
  "name": "superimg-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "SuperImg monorepo",
  "scripts": {
    "turbo:prepare": "node scripts/write-turbo-cache-key.mjs",
    "generate": "pnpm turbo:prepare && turbo run generate",
    "dev": "pnpm turbo:prepare && turbo run dev",
    "build": "pnpm turbo:prepare && turbo run build --filter=!docs",
    "build:affected": "pnpm turbo:prepare && turbo run build --affected --filter=!docs",
    "build:docs": "pnpm turbo:prepare && turbo run build --filter=docs",
    "build:render": "pnpm turbo:prepare && turbo run build --filter=@superimg/types --filter=@superimg/core --filter=@superimg/playwright --filter=@superimg/node --filter=@superimg/browser-export --filter=@superimg/edge-runtime --filter=@superimg/interactions --filter=@foxworth/superimg-cli... --filter=@foxworth/superimg",
    "bench:build": "pnpm --filter @superimg/benchmarks run measure",
    "bench:quick": "pnpm --filter @superimg/benchmarks run bench:quick",
    "bench:catalog": "pnpm --filter @superimg/benchmarks run bench:catalog",
    "bench:browser": "pnpm --filter @superimg/benchmarks run bench:browser",
    "bench:all": "pnpm build && pnpm build:docs && pnpm --filter @superimg/benchmarks run bench:all",
    "rebuild:render": "pnpm clean:render && pnpm build:render",
    "rebuild": "pnpm clean && pnpm build",
    "test": "pnpm turbo:prepare && turbo run test",
    "test:browser-inspection": "pnpm build:render && pnpm --filter @superimg/integration-tests test:browser-inspection",
    "verify:inspection": "pnpm check && pnpm verify:examples && pnpm test:browser-inspection",
    "test:affected": "pnpm turbo:prepare && turbo run test --affected",
    "test:coverage": "pnpm turbo:prepare && turbo run test -- --coverage",
    "typecheck": "pnpm turbo:prepare && turbo run typecheck check-types",
    "lint": "pnpm turbo:prepare && turbo run lint lint:root",
    "lint:root": "eslint packages --max-warnings 0",
    "verify": "pnpm turbo:prepare && turbo run verify",
    "verify:examples": "pnpm build:render && tsx scripts/verify-example-catalog.mts",
    "verify:generated-artifacts": "node scripts/verify-generated-artifacts.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:public-boundary": "node scripts/verify-public-boundary.mjs",
    "verify:versions": "node scripts/verify-package-versions.mjs && pnpm verify:generated-artifacts",
    "check": "pnpm verify:library-boundaries && pnpm verify:public-boundary && pnpm verify:versions && pnpm verify:docs && pnpm turbo:prepare && turbo run build test typecheck check-types verify lint lint:root --concurrency=25% && pnpm verify:codec-consumers",
    "check:affected": "pnpm verify:public-boundary && pnpm verify:versions && pnpm verify:docs && pnpm turbo:prepare && turbo run build test typecheck check-types verify lint lint:root --affected --concurrency=25%",
    "clean": "pnpm turbo:prepare && turbo run clean",
    "clean:render": "pnpm turbo:prepare && turbo run clean --filter=@foxworth/superimg-cli...",
    "videos": "node ./packages/superimg-cli/dist/cli.js dev",
    "verify:library-boundaries": "node --test scripts/library-first-boundaries.test.mjs",
    "verify:library-consumers": "node scripts/verify-library-consumers.mjs",
    "verify:codec-consumers": "node scripts/verify-codec-consumers.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.18.0"
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@bytecodealliance/jco": "1.37.0",
    "@foxworth/superimg": "workspace:*",
    "@seydx/node-av-darwin-arm64": "^6.2.0",
    "@seydx/node-av-linux-arm64": "6.2.0",
    "@types/node": "catalog:",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "playwright": "catalog:"
  }
}
