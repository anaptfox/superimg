{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@emotion/unitless": [
        "./node_modules/@emotion/unitless/dist/emotion-unitless.esm.js"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
