{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "skipLibCheck": true, "noEmit": true, "types": ["node"]
  },
  "include": ["*.ts", "*.mts"]
}
