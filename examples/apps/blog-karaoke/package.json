{
  "name": "blog-karaoke",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a blog post URL or text file into a karaoke-style read-along video",
  "type": "module",
  "bin": {
    "blog-karaoke": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --enable-source-maps dist/cli.js",
    "dev": "tsx src/cli.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "superimg": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
