    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <strong>SuperImg <span style="font-weight:400;color:rgba(255,255,255,0.35)">× Astro</span></strong>
      <nav>
        <a href="/">Gallery</a>
        <a href="/docs">Docs pattern</a>
