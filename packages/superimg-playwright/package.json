{
  "name": "@superimg/playwright",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright-based server-side renderer for SuperImg",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./engine": {
      "import": "./dist/engine.js",
      "types": "./dist/engine.d.ts"
    },
    "./sharp-still-encoder": {
      "import": "./dist/sharp-still-encoder.js",
      "types": "./dist/sharp-still-encoder.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "superimg",
    "playwright",
    "rendering",
    "server"
  ],
  "license": "MIT",
  "devDependencies": {
    "@superimg/build-config": "workspace:*",
    "@superimg/stdlib": "workspace:*",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@mediabunny/dts": "catalog:",
    "@mediabunny/server": "catalog:",
    "@superimg/core": "workspace:*",
    "@superimg/types": "workspace:*",
    "execa": "^10.2.1",
    "hono": "catalog:",
    "mediabunny": "catalog:",
    "node-av": "6.2.0",
    "playwright": "catalog:",
    "playwright-core": "^1.65.0",
    "rolldown": "catalog:",
    "sharp": "catalog:",
    "three": "0.184.0"
  }
}
