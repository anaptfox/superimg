{
  "name": "@superimg/core",
  "version": "0.1.0",
  "private": true,
  "description": "Core environment-agnostic primitives for SuperImg",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./html": {
      "import": "./dist/html.js",
      "types": "./dist/html.d.ts"
    },
    "./bundler": {
      "import": "./dist/bundler.js",
      "types": "./dist/bundler.d.ts"
    },
    "./bundler-browser": {
      "import": "./dist/bundler-browser.js",
      "types": "./dist/bundler-browser.d.ts"
    },
    "./engine": {
      "import": "./dist/engine.js",
      "types": "./dist/engine.d.ts"
    },
    "./template-metadata": {
      "import": "./dist/template-metadata.js",
      "types": "./dist/template-metadata.d.ts"
    },
    "./bundler-plugin": {
      "import": "./dist/bundler-plugin.js",
      "types": "./dist/bundler-plugin.d.ts"
    },
    "./validation": {
      "import": "./dist/validation.js",
      "types": "./dist/validation.d.ts"
    },
    "./errors": {
      "import": "./dist/errors.js",
      "types": "./dist/errors.d.ts"
    },
    "./errors-node": {
      "import": "./dist/errors-node.js",
      "types": "./dist/errors-node.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    }
  },
  "scripts": {
    "generate": "node --import tsx scripts/generate-runtime.ts",
    "build": "pnpm run generate && tsdown",
    "dev": "tsdown --watch",
    "test": "vitest --run",
    "clean": "rm -rf dist src/generated"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "superimg",
    "core",
    "rendering",
    "video"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/code-frame": "^8.0.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@rolldown/browser": "1.1.3",
    "@superimg/stdlib": "workspace:*",
    "@superimg/types": "workspace:*",
    "oxc-parser": "^0.137.0",
    "picocolors": "^1.1.1",
    "rolldown": "1.1.3",
    "source-map-js": "^1.2.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/babel__code-frame": "^7.27.0",
    "@types/node": "^26.0.0"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-darwin-arm64": "^0.137.0",
    "@oxc-parser/binding-darwin-x64": "^0.137.0",
    "@oxc-parser/binding-linux-arm64-gnu": "^0.137.0",
    "@oxc-parser/binding-linux-arm64-musl": "^0.137.0",
    "@oxc-parser/binding-linux-x64-gnu": "^0.137.0",
    "@oxc-parser/binding-linux-x64-musl": "^0.137.0",
    "@oxc-parser/binding-win32-arm64-msvc": "^0.137.0",
    "@oxc-parser/binding-win32-x64-msvc": "^0.137.0"
  }
}
