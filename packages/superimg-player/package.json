{
  "name": "@superimg/player",
  "version": "0.1.0",
  "private": true,
  "description": "Browser player for SuperImg templates",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./inspection": {
      "types": "./dist/inspection.d.ts",
      "import": "./dist/inspection.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./timeline": {
      "types": "./dist/timeline-lanes.d.ts",
      "import": "./dist/timeline-lanes.js"
    },
    "./program": {
      "types": "./dist/program.d.ts",
      "import": "./dist/program.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "default": "./dist/dom.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown",
    "test": "vitest --run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "styles"
  ],
  "sideEffects": false,
  "keywords": [
    "superimg",
    "player",
    "video",
    "animation",
    "browser"
  ],
  "license": "MIT",
  "devDependencies": {
    "@superimg/build-config": "workspace:*",
    "@superimg/stdlib": "workspace:*",
    "happy-dom": "catalog:"
  },
  "dependencies": {
    "@superimg/core": "workspace:*",
    "@superimg/media": "workspace:*",
    "@superimg/types": "workspace:*"
  }
}
