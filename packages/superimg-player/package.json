{
  "name": "@superimg/player",
  "version": "0.1.0",
  "private": true,
  "description": "Browser player for SuperImg templates",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown",
    "test": "vitest --run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "styles"
  ],
  "sideEffects": false,
  "keywords": [
    "superimg",
    "player",
    "video",
    "animation",
    "browser"
  ],
  "license": "MIT",
  "dependencies": {
    "@superimg/core": "workspace:*",
    "@superimg/media": "workspace:*",
    "@superimg/stdlib": "workspace:*",
    "@superimg/types": "workspace:*",
    "zustand": "^5.0.14"
  }
}
