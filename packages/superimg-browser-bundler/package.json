{
  "name": "@superimg/browser-bundler",
  "version": "0.0.16",
  "description": "Self-contained browser template compiler for SuperImg (rolldown WASM inlined)",
  "type": "module",
  "main": "./dist/browser-bundler.js",
  "module": "./dist/browser-bundler.js",
  "types": "./dist/browser-bundler.d.ts",
  "exports": {
    ".": {
      "types": "./dist/browser-bundler.d.ts",
      "import": "./dist/browser-bundler.js",
      "default": "./dist/browser-bundler.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build-standalone.mjs && node scripts/verify-standalone.mjs",
    "clean": "rm -rf dist",
    "verify:build": "node scripts/verify-standalone.mjs"
  },
  "dependencies": {
    "@rolldown/browser": "1.1.3"
  },
  "devDependencies": {
    "@superimg/core": "workspace:*",
    "rolldown": "1.1.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anaptfox/superimg"
  }
}