{
  "name": "@superimg/browser-export",
  "version": "0.1.0",
  "private": true,
  "description": "Browser capture and export runtime for SuperImg MediaSession",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./encoder": {
      "import": "./dist/encoder.js",
      "types": "./dist/encoder.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime.js",
      "types": "./dist/runtime.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest --run --passWithNoTests",
    "clean": "rm -rf dist",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "node ../../scripts/typecheck-native.mjs -p tsconfig.json --noEmit"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "dependencies": {
    "@mediabunny/dts": "catalog:",
    "@superimg/core": "workspace:*",
    "@superimg/media": "workspace:*",
    "@superimg/types": "workspace:*",
    "@zumer/snapdom": "catalog:",
    "@zumer/snapdom-pdf": "1.0.1",
    "@zumer/snapdom-plugins": "5.0.0",
    "@zumer/snapdom-vector": "1.0.0",
    "mediabunny": "catalog:"
  },
  "devDependencies": {
    "@superimg/build-config": "workspace:*",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/ui": "catalog:",
    "happy-dom": "catalog:",
    "vitest": "catalog:"
  }
}
