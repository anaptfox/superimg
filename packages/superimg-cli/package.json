{
  "name": "@superimg/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Private CLI and server implementation for the public superimg package",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./integration": {
      "import": "./dist/integration.js",
      "types": "./dist/integration.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown && node ../build-policy/check-externals.mjs --profile cli",
    "dev": "tsdown --watch",
    "test": "vitest --run --passWithNoTests",
    "check-externals": "node ../build-policy/check-externals.mjs --profile cli",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "@hono/node-server": "^2.0.6",
    "@mediabunny/server": "^1.49.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@superimg/browser-export": "workspace:*",
    "@superimg/core": "workspace:*",
    "@superimg/node": "workspace:*",
    "@superimg/player": "workspace:*",
    "@superimg/skill": "workspace:*",
    "@superimg/stdlib": "workspace:*",
    "@superimg/types": "workspace:*",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "execa": "^9.6.1",
    "hono": "^4.12.27",
    "ink": "^7.1.0",
    "mediabunny": "^1.49.0",
    "oxc-parser": "^0.137.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.61.1",
    "react": "catalog:",
    "rolldown": "1.1.3",
    "sharp": "^0.35.2",
    "vite": "^8.1.0",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "@babel/code-frame": "^8.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "catalog:",
    "@types/ws": "^8.18.1",
    "tailwindcss": "^4.3.1"
  }
}
