{
  "name": "@superimg/media",
  "version": "0.1.0",
  "private": true,
  "description": "Browser media session runtime for SuperImg templates",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest --run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "dependencies": {
    "@superimg/core": "workspace:*",
    "@superimg/stdlib": "workspace:*",
    "@superimg/types": "workspace:*",
    "morphdom": "^2.7.8"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "vitest": "^4.1.9"
  }
}
