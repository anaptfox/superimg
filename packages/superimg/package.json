{
  "name": "superimg",
  "version": "0.0.16",
  "description": "Programmatic video generation with HTML/CSS templates",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-server": "./dist/index.js",
      "edge-light": "./dist/index.js",
      "workerd": "./dist/index.js",
      "deno": "./dist/index.js",
      "worker": "./dist/index.js",
      "browser": "./dist/index.js",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.server.d.ts",
      "node": "./dist/index.server.js",
      "import": "./dist/index.server.js",
      "default": "./dist/index.server.js"
    },
    "./browser": {
      "types": "./dist/index.browser.d.ts",
      "browser": "./dist/index.browser.js",
      "import": "./dist/index.browser.js",
      "default": "./dist/index.browser.js"
    },
    "./edge": {
      "types": "./dist/index.edge.d.ts",
      "edge-light": "./dist/index.edge.js",
      "workerd": "./dist/index.edge.js",
      "deno": "./dist/index.edge.js",
      "worker": "./dist/index.edge.js",
      "import": "./dist/index.edge.js",
      "default": "./dist/index.edge.js"
    },
    "./player": {
      "types": "./dist/player.d.ts",
      "browser": "./dist/player.js",
      "import": "./dist/player.js",
      "default": "./dist/player.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "browser": "./dist/media.js",
      "import": "./dist/media.js",
      "default": "./dist/media.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js",
      "default": "./dist/define.js"
    },
    "./bundler": {
      "types": "./dist/bundler-browser.d.ts",
      "browser": "./dist/bundler-browser.js",
      "import": "./dist/bundler-browser.js",
      "default": "./dist/bundler-browser.js"
    },
    "./stdlib/code": {
      "types": "./dist/stdlib/code.d.ts",
      "import": "./dist/stdlib/code.js",
      "default": "./dist/stdlib/code.js"
    },
    "./stdlib/text": {
      "types": "./dist/stdlib/text.d.ts",
      "import": "./dist/stdlib/text.js",
      "default": "./dist/stdlib/text.js"
    },
    "./stdlib/cue": {
      "types": "./dist/stdlib/cue.d.ts",
      "import": "./dist/stdlib/cue.js",
      "default": "./dist/stdlib/cue.js"
    },
    "./stdlib/easing": {
      "types": "./dist/stdlib/easing.d.ts",
      "import": "./dist/stdlib/easing.js",
      "default": "./dist/stdlib/easing.js"
    },
    "./stdlib/math": {
      "types": "./dist/stdlib/math.d.ts",
      "import": "./dist/stdlib/math.js",
      "default": "./dist/stdlib/math.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "react-server": {
        "types": "./dist/react/react-server.d.ts",
        "default": "./dist/react/react-server.js"
      },
      "browser": "./dist/react/index.js",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./react/player": {
      "types": "./dist/react/player.d.ts",
      "react-server": "./dist/react/player.js",
      "browser": "./dist/react/player.js",
      "import": "./dist/react/player.js",
      "default": "./dist/react/player.js"
    },
    "./react/compile": {
      "types": "./dist/react/compile.d.ts",
      "browser": "./dist/react/compile.js",
      "import": "./dist/react/compile.js",
      "default": "./dist/react/compile.js"
    },
    "./react/session": {
      "types": "./dist/react/session.d.ts",
      "browser": "./dist/react/session.js",
      "import": "./dist/react/session.js",
      "default": "./dist/react/session.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:node": "tsdown --config tsdown.node.ts",
    "build:define": "tsdown --config tsdown.define.ts",
    "build:edge": "tsdown --config tsdown.edge.ts",
    "build:browser": "tsdown --config tsdown.browser.ts",
    "assemble": "node scripts/assemble-builds.mjs && superimg-generate-platform-manifest .",
    "build": "node scripts/verify-assembled.mjs",
    "dev": "tsdown --watch",
    "test": "vitest --run",
    "clean": "rm -rf dist .build",
    "verify:build": "superimg-check-externals --profile superimg && superimg-check-workerd-compat && superimg-check-platform-self-contained && superimg-check-no-react",
    "verify:package": "publint && node scripts/verify-attw.mjs",
    "verify": "pnpm run verify:build && pnpm run verify:package"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "video",
    "rendering",
    "html",
    "css",
    "animation",
    "programmatic"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anaptfox/superimg"
  },
  "homepage": "https://github.com/anaptfox/superimg#readme",
  "bugs": {
    "url": "https://github.com/anaptfox/superimg/issues"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "acorn": "^8.17.0",
    "colord": "^2.9.3",
    "date-fns": "^4.4.0",
    "morphdom": "^2.7.8",
    "oxc-parser": "^0.137.0",
    "path-data-parser": "^0.1.0",
    "rolldown": "1.1.3",
    "roughjs": "4.6.6",
    "source-map-js": "^1.2.1",
    "simplex-noise": "^4.0.3",
    "zustand": "^5.0.14"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-darwin-arm64": "^0.137.0",
    "@oxc-parser/binding-darwin-x64": "^0.137.0",
    "@oxc-parser/binding-linux-arm64-gnu": "^0.137.0",
    "@oxc-parser/binding-linux-arm64-musl": "^0.137.0",
    "@oxc-parser/binding-linux-x64-gnu": "^0.137.0",
    "@oxc-parser/binding-linux-x64-musl": "^0.137.0",
    "@oxc-parser/binding-win32-arm64-msvc": "^0.137.0",
    "@oxc-parser/binding-win32-x64-msvc": "^0.137.0",
    "sharp": "^0.35.2"
  },
  "peerDependencies": {
    "@rolldown/browser": "1.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@rolldown/browser": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@superimg/build-config": "workspace:*",
    "@superimg/browser-export": "workspace:*",
    "@superimg/cli": "workspace:*",
    "@superimg/core": "workspace:*",
    "@superimg/media": "workspace:*",
    "@superimg/player": "workspace:*",
    "@superimg/runtime-web": "workspace:*",
    "@superimg/skill": "workspace:*",
    "@superimg/stdlib": "workspace:*",
    "@rolldown/browser": "1.1.3",
    "@superimg/types": "workspace:*",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "^8.18.1",
    "@arethetypeswrong/core": "^0.18.3",
    "@arethetypeswrong/cli": "^0.18.5",
    "happy-dom": "^20.10.6",
    "publint": "^0.3.21",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rolldown": "1.1.3",
    "tailwindcss": "^4.3.1"
  }
}
