    "build:player": "tsdown --config tsdown.player.ts && tsdown --config tsdown.program.ts && tsdown --config tsdown.inspection.ts",
    "build:browser": "tsdown --config tsdown.browser.ts",
    "assemble": "node scripts/assemble-builds.mjs && node ../../tooling/build-config/dist/generate-platform-manifest.mjs .",
    "build": "node scripts/verify-assembled.mjs",
    "dev": "tsdown --watch",
    "test": "vitest --run",
    "clean": "rm -rf dist .build",
    "verify:build": "node ../../tooling/build-config/dist/check-externals.mjs --profile superimg && node ../../tooling/build-config/dist/check-workerd-compat.mjs && node ../../tooling/build-config/dist/check-platform-self-contained.mjs && node ../../tooling/build-config/dist/check-no-react.mjs && node scripts/check-player-bundle-size.mjs",
    "verify:player-size": "node scripts/check-player-bundle-size.mjs",
    "verify:package": "publint && node scripts/verify-attw.mjs",
    "verify": "pnpm run verify:build && pnpm run verify:package"
