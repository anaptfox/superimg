{
  "name": "@superimg/node",
  "version": "0.1.0",
  "private": true,
  "description": "Node render runtime for SuperImg",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./internal": {
      "import": "./dist/internal.js",
      "types": "./dist/internal.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "dependencies": {
    "@superimg/playwright": "workspace:*",
    "@superimg/types": "workspace:*"
  },
  "devDependencies": {
    "@superimg/build-config": "workspace:*",
    "vitest": "^4.1.9"
  }
}
