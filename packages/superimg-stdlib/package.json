  "scripts": {
    "generate": "node scripts/gen-katex-css.mjs",
    "verify:generated": "node scripts/gen-katex-css.mjs --check",
    "verify": "pnpm run verify:generated",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest --run",
    "clean": "rm -rf dist .generated"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "superimg",
    "easing",
    "animation",
    "stdlib"
  ],
  "license": "MIT",
  "dependencies": {
