      "import": "./dist/code.js",
      "types": "./dist/code.d.ts"
    },
    "./cue": {
      "import": "./dist/cue/index.js",
      "types": "./dist/cue/index.d.ts"
    },
    "./director": {
      "import": "./dist/director.js",
      "types": "./dist/director.d.ts"
    },
    "./carousel": {
