{
  "name": "@superimg/dev-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Private browser UI for the SuperImg development server",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "clean": "rm -rf dist",
    "typecheck": "node ../../scripts/typecheck-native.mjs -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "dependencies": {
    "@foxworth/superimg": "workspace:*",
    "@superimg/browser-export": "workspace:*",
    "@superimg/core": "workspace:*",
    "@superimg/player": "workspace:*",
    "@superimg/stdlib": "workspace:*",
    "@superimg/types": "workspace:*",
    "mediabunny": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
