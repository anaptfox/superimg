{
  "name": "@superimg/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Browser runtime for SuperImg (renderer, encoder, preview)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./encoder": {
      "import": "./dist/encoder.js",
      "types": "./dist/encoder.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown",
    "test": "vitest --run --passWithNoTests --config vitest.node.config.ts",
    "test:browser": "vitest --run --passWithNoTests --config vitest.config.ts",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "superimg",
    "runtime",
    "browser",
    "rendering",
    "video"
  ],
  "license": "MIT",
  "dependencies": {
    "@superimg/core": "workspace:*",
    "@superimg/types": "workspace:*",
    "@zumer/snapdom": "^2.15.0",
    "mediabunny": "^1.49.0"
  },
  "devDependencies": {
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "playwright": "^1.61.1"
  }
}
