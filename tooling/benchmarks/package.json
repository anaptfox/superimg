{
  "name": "@superimg/benchmarks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "measure": "node scripts/measure-build-cache.mjs",
    "bench:quick": "node scripts/measure-quick.mjs --check",
    "bench:catalog": "node scripts/measure-performance.mjs --check",
    "bench:browser": "node scripts/measure-browser.mjs --check",
    "bench:all": "pnpm run bench:quick && pnpm run bench:catalog && pnpm run bench:browser",
    "clean": "rm -rf .results"
  },
  "dependencies": {
    "@zumer/snapdom": "^2.15.0",
    "playwright": "^1.61.1",
    "rolldown": "1.1.3",
    "sharp": "^0.35.2"
  }
}
